# Keep secrets, local data and build junk out of the build context (and so out of the image).
.git
.gitattributes
.github
.claude
.env
.env.*
**/.env
**/.env.*
# Must come after every .env.* exclusion (the last matching rule wins):
!.env.example
**/credentials*
data/
backend/data/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
**/.venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
backend/reports
backend/tests
.demo
.manual-demo
.local-docs
.design-mockups
docs/manual/*.pdf
docs/manual/*.docx
docs/manual/*.html
dist/
coursepilot-v*.zip
coursepilot-v*.zip.sha256
