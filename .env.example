# CoursePilot settings. This file is the documented template: copy it to .env (setup does this
# for you) and edit the values there. Never commit .env, it holds secrets.
# Every start and every setup run refreshes .env from this template: all options are listed with
# these explanations, your values are kept, your own extra settings are kept at the end.

# ===== Server and security =====

# Run mode.
# Options: development | test | production
# production enforces a strong SECRET_KEY, secure cookies and (unless ALLOW_INSECURE_HTTP) https.
APP_ENV=development

# Network address the web app listens on.
# 127.0.0.1 = this computer only. 0.0.0.0 = every network interface (setup sets it for LAN use).
APP_HOST=127.0.0.1

# Port the web app listens on.
# Range: 1-65535
APP_PORT=8000

# The address users type in their browser. Used for cookies and the Origin check.
# Must start with https:// in production (unless ALLOW_INSECURE_HTTP=true).
BASE_URL=http://localhost:8000

# Secret used to sign login forms. Generated by setup; keep it secret, never commit it.
# In production it must be random and at least 32 characters.
SECRET_KEY=change-me

# How long a login stays valid, in hours.
# Range: 1 or more
SESSION_TTL_HOURS=12

# Maximum login attempts per minute, per client address and per email.
# Range: 1 or more
LOGIN_RATE_LIMIT_PER_MIN=10

# Set to true ONLY when CoursePilot runs behind a trusted reverse proxy that sets X-Forwarded-For.
# Otherwise clients could fake their address and dodge rate limits.
# Options: true | false
BEHIND_PROXY=false

# Allow production over plain http:// (no encryption). Only for a closed, trusted network.
# Passwords and cookies then cross the network in clear text. Setup asks about this.
# Options: true | false
ALLOW_INSECURE_HTTP=false

# Maximum size of a normal request body in MB (the document upload has its own limit).
# Range: 1 or more
MAX_REQUEST_BODY_MB=2

# ===== Storage =====

# Folder for the database, uploaded files and backups. Keep it on a local disk, not a network share.
# Relative paths are anchored at the CoursePilot folder.
DATA_DIR=./data

# Main database. Only SQLite is supported.
# Format: sqlite+aiosqlite:///path/to/file.db
DATABASE_URL=sqlite+aiosqlite:///./data/coursepilot.db

# Database that holds the chat memory of the assistant.
CHECKPOINT_DB_PATH=./data/checkpoints.db

# Where uploaded files are stored.
# Options: local | s3
# local = in DATA_DIR. s3 = an S3-compatible bucket (also Cloudflare R2); needs the S3_* options below.
STORAGE_BACKEND=local

# S3 only: endpoint address. Required for Cloudflare R2 and other non-AWS services, empty for AWS.
S3_ENDPOINT_URL=

# S3 only: bucket name.
S3_BUCKET=coursepilot-materials

# S3 only: access key id. Keep secret, never commit.
S3_ACCESS_KEY_ID=

# S3 only: secret access key. Keep secret, never commit.
S3_SECRET_ACCESS_KEY=

# S3 only: region. Use auto for Cloudflare R2.
S3_REGION=auto

# ===== Programme structure =====
# The structure is Years > Blocks > Modules. Seeding only adds rows, it never renames or deletes.

# Number of years in the programme.
# Range: 1 or more
PROGRAM_YEARS=3

# Number of blocks in each year.
# Range: 1 or more
BLOCKS_PER_YEAR=3

# Number of modules in each block.
# Range: 1 or more
MODULES_PER_BLOCK=3

# ===== Chat model (LLM) =====

# Which company's model answers the questions.
# Options: anthropic | gemini | ollama | openai_compatible
# anthropic and gemini are the recommended defaults and need ANTHROPIC_API_KEY or GOOGLE_API_KEY.
# ollama and openai_compatible run a model on your own hardware (for testing and local use):
# see the "Local AI" settings below. Local models can be slow; on a CPU-only server also raise
# AGENT_TIMEOUT_S (for example to 300).
LLM_PROVIDER=anthropic

# Model that writes the answers. Check the provider's current model names.
# anthropic: claude-sonnet-5-5 (default) | claude-opus-5-5
# gemini: gemini-2.5-flash | gemini-2.5-pro
# ollama: a model you pulled, for example qwen2.5:7b-instruct (see ollama.com/library)
# openai_compatible: the model name your server serves
# Changing LLM_PROVIDER does not change this automatically.
LLM_MODEL=claude-sonnet-5-5

# Cheaper, faster model for rewriting questions and sufficiency checks.
# anthropic: claude-haiku-5-5 (default)
# gemini: gemini-2.5-flash
# ollama and openai_compatible: usually the same as LLM_MODEL
LLM_FAST_MODEL=claude-haiku-5-5

# Maximum length of an answer, in tokens.
# Range: 64-16000
LLM_MAX_OUTPUT_TOKENS=1024

# Maximum length of the short helper calls (question rewriting, sufficiency checks), in tokens.
# Range: 16-2000
LLM_FAST_MAX_OUTPUT_TOKENS=256

# Anthropic prompt caching: repeated parts of a prompt cost less. No effect on other providers.
# Options: true | false
LLM_PROMPT_CACHE=true

# Anthropic only: how much the model thinks (more effort = better answers, slower, more tokens).
# Thinking counts toward the output limits above.
# Options: low | medium | high | xhigh | max | (empty = the model's default)
LLM_EFFORT=low

# API key for Anthropic (Claude). Keep secret, never commit.
ANTHROPIC_API_KEY=

# API key for Google (Gemini chat and Gemini embeddings share it). Keep secret, never commit.
GOOGLE_API_KEY=

# ===== Local AI (optional, for testing) =====
# Used only when LLM_PROVIDER or EMBEDDING_PROVIDER is ollama, openai_compatible or local.

# Address of your Ollama server (chat with LLM_PROVIDER=ollama, embeddings with
# EMBEDDING_PROVIDER=ollama). Must start with http:// or https://.
# With the Docker Compose profile local-ai use http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# Address of an OpenAI-compatible server (vLLM, LM Studio, llama.cpp server, LocalAI, or Ollama's
# own /v1), including the /v1 part. Needed for LLM_PROVIDER=openai_compatible; empty = not used.
# Example: http://localhost:8001/v1
LOCAL_LLM_BASE_URL=

# API key for that server. Many local servers ignore it, so it can stay empty.
# Keep secret, never commit.
LOCAL_LLM_API_KEY=

# Address of the OpenAI-compatible server that computes embeddings
# (EMBEDDING_PROVIDER=openai_compatible). Empty = use LOCAL_LLM_BASE_URL.
LOCAL_EMBEDDING_BASE_URL=

# Where in-process embeddings run (EMBEDDING_PROVIDER=local, needs the PyTorch extra).
# Options: auto | cpu | cuda | mps
# auto picks cuda when an NVIDIA GPU is available, mps on Apple silicon, otherwise cpu. The bundled
# PyTorch is the CPU-only build, so cuda only works if you install a CUDA PyTorch yourself.
LOCAL_EMBEDDING_DEVICE=auto

# ===== Embeddings =====
# Embeddings turn text into numbers for search. Independent of the chat model.
# Changing EMBEDDING_PROVIDER, EMBEDDING_MODEL or EMBEDDING_DIM requires re-processing all
# material: python -m app.cli reindex-all

# Who computes the embeddings.
# Options: gemini | voyage | openai | ollama | openai_compatible | local
# gemini, voyage and openai need GOOGLE_API_KEY, VOYAGE_API_KEY or OPENAI_API_KEY respectively.
# ollama: an Ollama server (OLLAMA_BASE_URL). openai_compatible: a server that offers
# /v1/embeddings (LOCAL_EMBEDDING_BASE_URL or LOCAL_LLM_BASE_URL).
# local: computed inside CoursePilot with sentence-transformers / PyTorch. Needs the optional
# extra: cd backend && python -m uv sync --extra local-embeddings (about 1-2 GB).
EMBEDDING_PROVIDER=gemini

# Embedding model (and its usual dimension).
# gemini: gemini-embedding-001 (768)
# voyage: voyage-3.5 (1024)
# openai: text-embedding-3-small (1536)
# ollama: nomic-embed-text (768) | bge-m3 (1024) | mxbai-embed-large (1024)
# local: BAAI/bge-small-en-v1.5 (384) | BAAI/bge-m3 (1024)
# openai_compatible: the embedding model your server serves
EMBEDDING_MODEL=gemini-embedding-001

# Number of values per embedding. Must match the model above.
# Range: 1 or more
EMBEDDING_DIM=768

# Text put in front of every query before it is embedded. Some models need this (the built-in
# default for common models is used when this is empty). Changing it requires re-processing:
# python -m app.cli reindex-all
EMBEDDING_QUERY_PREFIX=

# Text put in front of every document passage before it is embedded. Same rules as above.
EMBEDDING_DOCUMENT_PREFIX=

# API key for Voyage embeddings. Keep secret, never commit.
VOYAGE_API_KEY=

# API key for OpenAI embeddings. Keep secret, never commit.
OPENAI_API_KEY=

# ===== Web search =====
# Used only when the uploaded material cannot answer a question. Only the search query is sent.

# Web search provider.
# Options: tavily | none
# none switches web search off completely.
WEB_SEARCH_PROVIDER=tavily

# API key for Tavily. Without it the assistant answers from the material only.
# Keep secret, never commit.
TAVILY_API_KEY=

# Maximum number of web searches per question.
# Range: 0 or more (0 = no web searches)
WEB_MAX_QUERIES=2

# Optional: only use web results from these sites (comma-separated), e.g. example.edu,example.org
# Empty = any site.
WEB_ALLOWED_DOMAINS=

# ===== Retrieval =====

# How many passages of the material go to the model for each question.
# Range: 1 or more
RETRIEVAL_TOP_K=6

# Characters of each passage the model sees. The passage viewer always shows the full text.
# Range: 200-4000
RETRIEVAL_LLM_CHARS=1000

# Minimum similarity (0-1) of the best passage for a search step to count as good enough.
# 0 = off. Try 0.3-0.5 and tune with the evals. Too high sends many questions to the web.
# Range: 0.0-1.0
RETRIEVAL_MIN_SCORE=0.0

# Minimum number of passages a search step must find to count as good enough.
# Range: 0 or more
RETRIEVAL_MIN_HITS=1

# Most passages one document may contribute to an answer, so a short handout cannot crowd out a
# textbook. Unused slots are refilled from other passages.
# Range: 1 or more
RETRIEVAL_MAX_PER_DOCUMENT=4

# Re-rank the search results (experimental).
# Options: true | false
RERANK_ENABLED=false

# ===== Uploads, limits and costs =====

# Largest file a faculty member may upload, in MB.
# Range: 1 or more
UPLOAD_MAX_MB=50

# Read text from scanned PDFs with OCR (needs Tesseract installed). Off by default.
# Options: true | false
OCR_ENABLED=false

# Messages one user may send per day (UTC). Protects against runaway costs.
# Range: 1 or more
CHAT_DAILY_LIMIT_PER_USER=100

# Chat requests one user may send per minute (on top of the daily limit). Counted per process.
# Range: 1 or more
CHAT_RATE_LIMIT_PER_MIN=10

# Upload requests one user may send per minute (the page sends one per file). Counted per process.
# Range: 1 or more
UPLOAD_RATE_LIMIT_PER_MIN=60

# Time limit for answering one question, in seconds.
# Range: 1 or more
AGENT_TIMEOUT_S=60

# ===== Worker =====
# The worker processes uploaded documents in the background.

# How often the worker looks for new jobs, in seconds.
# Range: greater than 0
WORKER_POLL_INTERVAL_S=2.0

# A running job older than this is considered stuck and re-queued, in seconds.
# The smaller of this and HEARTBEAT_STALE_S applies.
# Range: 30 or more
JOB_LOCK_TIMEOUT_S=1800

# A running job without a heartbeat for this long (the worker died) is re-queued, in seconds.
# Range: 15 or more
HEARTBEAT_STALE_S=120

# Most pages (PDF) or slides (PPTX) processed per document. Larger files fail with a clear error.
# Range: 1 or more
PARSE_MAX_PAGES=2000

# Time limit for reading one document, in seconds.
# Range: 1 or more
PARSE_TIMEOUT_S=120

# Texts sent to the embedding provider per request.
# Range: 1-100
EMBEDDING_BATCH_SIZE=64

# ===== Logging, tracing and retention =====

# LangSmith tracing key. Tracing is OFF unless this is set. When set, prompts, answers and
# material excerpts are sent to LangSmith (a third party). Keep secret, never commit.
LANGSMITH_API_KEY=

# How much the application logs.
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Audit log entries older than this many days are deleted by the worker.
# Range: 1 or more
AUDIT_RETENTION_DAYS=365

# Failed-login audit entries older than this many days are deleted by the worker.
# Range: 1 or more
LOGIN_FAILED_AUDIT_RETENTION_DAYS=30
